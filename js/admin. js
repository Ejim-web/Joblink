import { db } from "./firebase-config.js";
import { collection, getDocs, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
import { escapeHtml, showToast } from "./utils.js";

const usersCol = collection(db, "users");
const jobsCol = collection(db, "jobs");
const applicationsCol = collection(db, "applications");

let adminContainer = null;

export async function renderAdmin(container) {
    adminContainer = container;
    await loadAdminDashboard();
}

async function loadAdminDashboard() {
    if (!adminContainer) return;
    adminContainer.innerHTML = `<div class="loader"></div>`;
    const usersSnapshot = await getDocs(usersCol);
    const jobsSnapshot = await getDocs(jobsCol);
    const appsSnapshot = await getDocs(applicationsCol);
    adminContainer.innerHTML = `
        <div class="card">
            <h2>Admin Dashboard</h2>
            <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:1rem;">
                <div style="background:var(--gradient); padding:1rem; border-radius:1rem; flex:1; text-align:center;"><div style="font-size:1.5rem; font-weight:800;">${usersSnapshot.size}</div><div>Users</div></div>
                <div style="background:var(--gradient); padding:1rem; border-radius:1rem; flex:1; text-align:center;"><div style="font-size:1.5rem; font-weight:800;">${jobsSnapshot.size}</div><div>Jobs</div></div>
                <div style="background:var(--gradient); padding:1rem; border-radius:1rem; flex:1; text-align:center;"><div style="font-size:1.5rem; font-weight:800;">${appsSnapshot.size}</div><div>Applications</div></div>
            </div>
            <h3>Users</h3>
            ${usersSnapshot.docs.map(doc => `
                <div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem; border-bottom:1px solid var(--border);">
                    <span><strong>${escapeHtml(doc.data().name)}</strong><br><span style="font-size:0.7rem;">${doc.data().email}</span><br><span style="background:var(--primary); color:white; padding:0.1rem 0.4rem; border-radius:0.5rem; font-size:0.6rem;">${doc.data().role}</span></span>
                    <button class="delete-user" data-id="${doc.id}" style="background:var(--danger); border:none; padding:0.3rem 0.8rem; border-radius:0.5rem; color:white;">Delete</button>
                </div>
            `).join('')}
            <h3 style="margin-top:1rem;">Jobs</h3>
            ${jobsSnapshot.docs.map(doc => `
                <div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem; border-bottom:1px solid var(--border);">
                    <span><strong>${escapeHtml(doc.data().title)}</strong><br><span style="font-size:0.7rem;">${escapeHtml(doc.data().employerName)}</span></span>
                    <button class="delete-job" data-id="${doc.id}" style="background:var(--danger); border:none; padding:0.3rem 0.8rem; border-radius:0.5rem; color:white;">Delete</button>
                </div>
            `).join('')}
        </div>
    `;
    document.querySelectorAll('.delete-user').forEach(btn => {
        btn.onclick = async () => {
            if (confirm("Delete this user?")) {
                await deleteDoc(doc(usersCol, btn.dataset.id));
                await loadAdminDashboard();
                showToast("User deleted");
            }
        };
    });
    document.querySelectorAll('.delete-job').forEach(btn => {
        btn.onclick = async () => {
            if (confirm("Delete this job?")) {
                await deleteDoc(doc(jobsCol, btn.dataset.id));
                await loadAdminDashboard();
                showToast("Job deleted");
            }
        };
    });
}
