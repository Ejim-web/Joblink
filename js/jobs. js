import { db } from "./firebase-config.js";
import { collection, query, orderBy, limit, startAfter, getDocs, addDoc, updateDoc, deleteDoc, doc, where, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
import { escapeHtml, getTimeAgo, showToast, debounce } from "./utils.js";
import { getCurrentUser, getCurrentUserData } from "./auth.js";

const jobsCol = collection(db, "jobs");
const savedJobsCol = collection(db, "savedJobs");
const applicationsCol = collection(db, "applications");

let jobsContainer = null;
let lastJobDoc = null;
let isLoading = false;
let hasMore = true;
let savedJobsSet = new Set();
let currentFilter = "all";
let searchKeyword = "";

export async function renderJobs(container) {
    jobsContainer = container;
    await loadSavedJobs();
    await loadJobs(true);
    setupSearchAndFilters();
}

async function loadSavedJobs() {
    const snapshot = await getDocs(query(savedJobsCol, where("userId", "==", getCurrentUser().uid)));
    savedJobsSet.clear();
    snapshot.forEach(d => savedJobsSet.add(d.data().jobId));
}

export async function loadJobs(reset = true) {
    if (!jobsContainer) return;
    if (reset) {
        jobsContainer.innerHTML = `<div class="skeleton-card skeleton"></div><div class="skeleton-card skeleton"></div>`;
        lastJobDoc = null;
        hasMore = true;
    }
    if (isLoading || !hasMore) return;
    isLoading = true;

    let q = query(jobsCol, orderBy("timestamp", "desc"), limit(10));
    if (lastJobDoc) q = query(jobsCol, orderBy("timestamp", "desc"), startAfter(lastJobDoc), limit(10));
    const snapshot = await getDocs(q);
    lastJobDoc = snapshot.docs[snapshot.docs.length - 1];
    hasMore = snapshot.docs.length === 10;
    let jobs = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));

    // Apply filters
    if (searchKeyword) {
        jobs = jobs.filter(j => j.title?.toLowerCase().includes(searchKeyword.toLowerCase()) || j.employerName?.toLowerCase().includes(searchKeyword.toLowerCase()));
    }
    if (currentFilter === 'remote') {
        jobs = jobs.filter(j => j.location?.toLowerCase().includes('remote'));
    }

    const newHtml = jobs.map(job => `
        <div class="card">
            <div style="display:flex; gap:1rem;">
                <div style="width:56px; height:56px; background:var(--gradient); border-radius:1rem; display:flex; align-items:center; justify-content:center;"><i class="fas fa-building"></i></div>
                <div style="flex:1;">
                    <div style="font-weight:700;">${escapeHtml(job.title)}</div>
                    <div style="color:var(--primary); font-size:0.8rem;">${escapeHtml(job.employerName)}</div>
                    <div style="display:flex; gap:0.75rem; font-size:0.7rem; color:var(--gray); margin:0.5rem 0;">
                        <span><i class="fas fa-map-marker-alt"></i> ${escapeHtml(job.location)}</span>
                        <span><i class="fas fa-money-bill-wave"></i> ${escapeHtml(job.salary)}</span>
                        <span><i class="fas fa-clock"></i> ${getTimeAgo(job.timestamp)}</span>
                    </div>
                </div>
            </div>
            <div style="display:flex; gap:0.75rem; margin-top:1rem;">
                <button class="save-job" data-id="${job.id}" style="flex:1; padding:0.5rem; background:var(--light); border:1px solid var(--border); border-radius:0.5rem;"><i class="fas fa-bookmark"></i> ${savedJobsSet.has(job.id) ? 'Saved' : 'Save'}</button>
                <button class="apply-job" data-id="${job.id}" style="flex:1; padding:0.5rem; background:var(--gradient); border:none; border-radius:0.5rem; color:white;">Apply</button>
            </div>
        </div>
    `).join('');

    jobsContainer.innerHTML = reset ? newHtml : jobsContainer.innerHTML + newHtml;
    if (hasMore && !reset) {
        const loadMoreBtn = document.createElement("button");
        loadMoreBtn.textContent = "Load More Jobs";
        loadMoreBtn.className = "btn-primary";
        loadMoreBtn.style.width = "auto";
        loadMoreBtn.style.padding = "0.5rem 1rem";
        loadMoreBtn.style.marginTop = "0.5rem";
        loadMoreBtn.onclick = () => loadJobs(false);
        jobsContainer.appendChild(loadMoreBtn);
    }

    attachJobHandlers();
    isLoading = false;
}

function attachJobHandlers() {
    document.querySelectorAll('.save-job').forEach(btn => {
        btn.onclick = async () => await toggleSaveJob(btn.dataset.id);
    });
    document.querySelectorAll('.apply-job').forEach(btn => {
        btn.onclick = async () => await applyForJob(btn.dataset.id);
    });
}

async function toggleSaveJob(jobId) {
    const ref = doc(savedJobsCol, `${getCurrentUser().uid}_${jobId}`);
    if (savedJobsSet.has(jobId)) {
        await deleteDoc(ref);
        savedJobsSet.delete(jobId);
        showToast("Removed from saved jobs");
    } else {
        await setDoc(ref, { userId: getCurrentUser().uid, jobId, savedAt: new Date() });
        savedJobsSet.add(jobId);
        showToast("Job saved!");
    }
    await loadJobs(true);
}

async function applyForJob(jobId) {
    const existing = await getDocs(query(applicationsCol, where("jobId", "==", jobId), where("applicantId", "==", getCurrentUser().uid)));
    if (!existing.empty) {
        showToast("You already applied");
        return;
    }
    await addDoc(applicationsCol, {
        jobId,
        applicantId: getCurrentUser().uid,
        status: 'applied',
        appliedAt: new Date()
    });
    showToast("Application submitted! 🎉");
}

function setupSearchAndFilters() {
    const searchInput = document.getElementById("jobSearchInput");
    if (searchInput) {
        const debouncedSearch = debounce(() => {
            searchKeyword = searchInput.value;
            loadJobs(true);
        }, 300);
        searchInput.addEventListener("input", debouncedSearch);
    }
    const filterChips = document.querySelectorAll('.filter-chip');
    filterChips.forEach(chip => {
        chip.onclick = () => {
            currentFilter = chip.dataset.filter;
            filterChips.forEach(c => c.style.background = 'var(--light)');
            chip.style.background = 'var(--gradient)';
            chip.style.color = 'white';
            loadJobs(true);
        };
    });
}

export function showPostJobModal() {
    const modal = document.createElement("div");
    modal.className = "modal active";
    modal.innerHTML = `
        <div class="modal-content">
            <h3>Post a Job</h3>
            <input id="jobTitle" placeholder="Job Title" style="width:100%; padding:0.9rem; margin-bottom:1rem; border:1.5px solid var(--border); border-radius:0.75rem;">
            <input id="companyName" placeholder="Company" style="width:100%; padding:0.9rem; margin-bottom:1rem; border:1.5px solid var(--border); border-radius:0.75rem;">
            <input id="jobLocation" placeholder="Location" style="width:100%; padding:0.9rem; margin-bottom:1rem; border:1.5px solid var(--border); border-radius:0.75rem;">
            <input id="jobSalary" placeholder="Salary" style="width:100%; padding:0.9rem; margin-bottom:1rem; border:1.5px solid var(--border); border-radius:0.75rem;">
            <textarea id="jobDesc" rows="4" placeholder="Description" style="width:100%; padding:0.9rem; margin-bottom:1rem; border:1.5px solid var(--border); border-radius:0.75rem;"></textarea>
            <button id="submitJob" class="btn-primary">Post Job</button>
            <button class="close-modal" style="margin-top:0.5rem; background:transparent; border:1px solid var(--border); width:100%; padding:0.875rem; border-radius:0.75rem;">Cancel</button>
        </div>
    `;
    document.body.appendChild(modal);
    const submitBtn = modal.querySelector("#submitJob");
    submitBtn.onclick = async () => {
        const title = modal.querySelector("#jobTitle").value;
        const company = modal.querySelector("#companyName").value;
        const location = modal.querySelector("#jobLocation").value;
        const salary = modal.querySelector("#jobSalary").value;
        const desc = modal.querySelector("#jobDesc").value;
        if (!title || !company || !location || !desc) {
            showToast("Please fill all fields");
            return;
        }
        await addDoc(jobsCol, {
            title,
            employerName: company,
            location,
            salary,
            description: desc,
            employerId: getCurrentUser().uid,
            timestamp: new Date()
        });
        showToast("Job posted!");
        modal.remove();
        loadJobs(true);
    };
    modal.querySelector(".close-modal").onclick = () => modal.remove();
}
